{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartcard-skills.dev/sc-key/schema.json",
  "title": "sc-key input",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "algorithm"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["generate", "derive", "diversify", "wrap", "unwrap", "kcv"]
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "AES-128", "AES-192", "AES-256", "3DES", "3DES-2KEY", "SM4",
        "HMAC-SHA256", "HMAC-SHA512", "GENERIC",
        "PBKDF2", "HKDF", "SCRYPT", "X9.63-KDF",
        "NXP-AES128", "AES-ECB",
        "AES-KW", "AES-KWP",
        "KCV-ZERO", "KCV-CMAC", "KCV-SHA256"
      ]
    },
    "key": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "kek": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "data": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "ikm": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "password": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "salt": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "info": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})*$" },
    "hash": {
      "type": "string",
      "enum": ["SHA-1", "SHA-224", "SHA-256", "SHA-384", "SHA-512", "SM3"]
    },
    "keylen": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "length": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "iterations": { "type": "integer", "minimum": 1 },
    "n": { "type": "integer", "minimum": 2 },
    "r": { "type": "integer", "minimum": 1 },
    "p": { "type": "integer", "minimum": 1 },
    "parity": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "diversify" } }, "required": ["operation"] },
      "then": { "required": ["key", "data"] }
    },
    {
      "if": { "properties": { "operation": { "enum": ["wrap", "unwrap"] } }, "required": ["operation"] },
      "then": { "required": ["kek", "data"] }
    },
    {
      "if": { "properties": { "operation": { "const": "kcv" } }, "required": ["operation"] },
      "then": { "required": ["key"] }
    }
  ]
}
