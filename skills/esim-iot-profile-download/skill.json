{
  "skillId": "esim.iot-profile-download",
  "version": "1.0.0",
  "name": "eSIM IoT Profile Download",
  "description": "IoT eSIM Profile 下载与启用（内嵌本地 SM-DP+，支持直接模式与 eIM 间接启用）",
  "category": "custom",
  "runtime": {
    "type": "python",
    "version": "3.11+"
  },
  "entry": "main.py",
  "inputSchema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": ["install_and_enable"]
      },
      "mode": {
        "type": "string",
        "enum": ["direct", "indirect"],
        "default": "indirect"
      },
      "eid": {
        "type": "string",
        "pattern": "^[0-9]{32}$"
      },
      "smdp_address": {
        "type": "string"
      },
      "matching_id": {
        "type": "string",
        "minLength": 5,
        "maxLength": 32
      },
      "iccid": {
        "type": "string",
        "pattern": "^[0-9]{10,20}$"
      },
      "profile_id": {
        "type": "string"
      },
      "eim_id": {
        "type": "string"
      },
      "profile_name": {
        "type": "string",
        "default": "IoT Profile"
      },
      "spn": {
        "type": "string"
      }
    },
    "required": ["operation", "eid", "smdp_address", "matching_id", "iccid", "profile_id"]
  }
}
